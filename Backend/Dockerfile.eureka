# Build stage
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY eureka-server/pom.xml .
RUN mvn dependency:go-offline -DexcludeTransitive

COPY eureka-server/src ./src
RUN mvn clean package -DskipTests

# Runtime stage
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /app/target/eureka-server-*.jar app.jar

EXPOSE 8761
ENV SPRING_APPLICATION_NAME=eureka-server
ENV SERVER_PORT=8761

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8761/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
