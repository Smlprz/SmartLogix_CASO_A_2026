# Dockerfile genérico para microservicios Backend (usuario, pedidos, envios, inventory)
# Uso: docker build -f Dockerfile.backend --build-arg SERVICE_NAME=usuario -t smartlogix-usuario:latest .

ARG SERVICE_NAME=usuario
ARG SERVICE_VERSION=1.0.0

# Build stage
FROM maven:3.9-eclipse-temurin-17 AS builder
ARG SERVICE_NAME

WORKDIR /app
COPY ${SERVICE_NAME}/pom.xml .
RUN mvn dependency:go-offline -DexcludeTransitive 2>/dev/null || true

COPY ${SERVICE_NAME}/src ./src
RUN mvn clean package -DskipTests

# Runtime stage
FROM eclipse-temurin:17-jre-alpine

ARG SERVICE_NAME
ARG SERVICE_VERSION

WORKDIR /app

# Copy built jar
COPY --from=builder /app/target/${SERVICE_NAME}-*.jar app.jar

# Environment variables
ENV SPRING_APPLICATION_NAME=${SERVICE_NAME}
ENV SERVICE_VERSION=${SERVICE_VERSION}
ENV EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Expose port (can be overridden)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
